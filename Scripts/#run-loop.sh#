#!/bin/sh
# [2026-10-28 T-029] Fire the autonomous board loop, but only once T-029 is
# closed. Owner asked for a single command that starts the loop when the
# dragon rig/walk task lands; the guard below keeps it from firing early.
# Usage: Scripts/run-loop.sh
set -eu
cd "$(dirname "$0")/.."

if ! grep -q '^- \[x\] T-029' TASKS.md; then
  echo "T-029 is not DONE yet in TASKS.md - loop not fired." >&2
  grep -m1 'T-029' TASKS.md >&2 || true
  exit 1
fi

echo "T-029 complete - firing board loop via hermes chat..."
exec hermes chat -q "Resume Under the Mountain. Run the AGENTS.md Session ritual in full, then read LOOP.md, then work the TASKS.md board one task per iteration (full AGENTS.md task loop each time), offloading bulk work to the muse-harness (muse_turn) per the muse-harness-orchestration skill, until no eligible task remains or a LOOP.md stop condition hits. Never push  cc."
